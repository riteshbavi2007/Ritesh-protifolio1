<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ritesh Bavi | Portfolio</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Header -->
    <header class="navbar">
        <div class="logo">RITESH<span>.</span></div>
        <nav>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#achievements">Achievements</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#gallery">Gallery</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
        <div class="controls">
            <button id="dark-mode-toggle" aria-label="Toggle Dark Mode">
                <i class="fas fa-moon"></i>
            </button>
            <div class="hamburger">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </header>

    <!-- Home Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <div class="hero-image">
                <!-- Replace 'assets/images/profile.jpg' with your actual photo path later -->
                <img src="https://via.placeholder.com/200" alt="Ritesh Bavi" class="profile-img">
            </div>
            <h1>Hi, I'm <span class="highlight">Ritesh Bavi</span></h1>
            <p>I am a BBA 1st Year student actively involved in my family business, bridging academic theory with real-world management.</p>
            <div class="hero-btns">
                <a href="#" class="btn primary">Download Resume <i class="fas fa-download"></i></a>
                <a href="#contact" class="btn secondary">Contact Me</a>
            </div>
        </div>
    </section>

    <!-- About Me Section -->
    <section id="about" class="about section-padding">
        <h2 class="section-title">About Me</h2>
        <div class="about-grid">
            <div class="about-card">
                <i class="fas fa-university"></i>
                <h3>Education</h3>
                <p>Currently pursuing BBA (1st Year), focusing on business administration and organizational efficiency.</p>
            </div>
            <div class="about-card">
                <i class="fas fa-book-open"></i>
                <h3>Interests</h3>
                <p>Passionate about learning general knowledge and staying updated with global business trends.</p>
            </div>
            <div class="about-card">
                <i class="fas fa-bolt"></i>
                <h3>Work Ethic</h3>
                <p>Committed to making work fast and perfect, ensuring high-quality results in every task.</p>
            </div>
            <div class="about-card">
                <i class="fas fa-user-tie"></i>
                <h3>Career Goal</h3>
                <p>Aiming to become a well-known personality in the business world through dedication and innovation.</p>
            </div>
        </div>
    </section>

    <!-- Achievements Section -->
    <section id="achievements" class="achievements section-padding bg-light">
        <h2 class="section-title">Achievements</h2>
        <div class="grid">
            <!-- Coursera Card -->
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="Coursera Cert">
                <div class="item-info">
                    <h3>Coursera Certificate</h3>
                    <p>Organizational Behavior: How to Manage People - IESE Business School.</p>
                </div>
            </div>
            <!-- Netacad Card -->
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="Netacad Cert">
                <div class="item-info">
                    <h3>Netacad Certificate</h3>
                    <p>Verified technical and networking skills through Cisco Networking Academy.</p>
                </div>
            </div>
            <!-- Yuva AI Card -->
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="Yuva AI Cert">
                <div class="item-info">
                    <h3>Yuva AI Certificate</h3>
                    <p>Completed AI training focusing on emerging technologies for business.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects section-padding">
        <h2 class="section-title">Projects</h2>
        <div class="grid">
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="AI4A Project">
                <div class="item-info">
                    <h3>Portfolio Project</h3>
                    <p>A comprehensive personal portfolio built with HTML, CSS, and JS.</p>
                    <a href="https://steady-haupia-23ce89.netlify.app/" target="_blank" class="btn-sm">View Project</a>
                </div>
            </div>
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="Design Thinking">
                <div class="item-info">
                    <h3>Design Thinking</h3>
                    <p>Applying problem-solving frameworks to family business challenges.</p>
                    <a href="#" class="btn-sm">View Project</a>
                </div>
            </div>
            <div class="item-card">
                <img src="https://via.placeholder.com/300x200" alt="Extra Project">
                <div class="item-info">
                    <h3>Business Integration</h3>
                    <p>Project on optimizing supply chain workflows for local retail.</p>
                    <a href="#" class="btn-sm">View Project</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="gallery section-padding bg-light">
        <h2 class="section-title">Gallery</h2>
        <div class="gallery-grid">
            <img src="https://via.placeholder.com/400" alt="Work 1" class="gallery-img">
            <img src="https://via.placeholder.com/400" alt="Work 2" class="gallery-img">
            <img src="https://via.placeholder.com/400" alt="Work 3" class="gallery-img">
            <img src="https://via.placeholder.com/400" alt="Work 4" class="gallery-img">
            <img src="https://via.placeholder.com/400" alt="Work 5" class="gallery-img">
            <img src="https://via.placeholder.com/400" alt="Work 6" class="gallery-img">
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact section-padding">
        <h2 class="section-title">Contact Me</h2>
        <div class="contact-container">
            <div class="contact-details">
                <div class="detail-item">
                    <i class="fas fa-envelope"></i>
                    <p>riteshbavi2007@gmail.com</p>
                </div>
                <div class="detail-item">
                    <i class="fas fa-phone"></i>
                    <p>+91 9823377585</p>
                </div>
                <div class="social-links">
                    <a href="#"><i class="fab fa-linkedin"></i></a>
                    <a href="#"><i class="fab fa-github"></i></a>
                </div>
            </div>
            <form id="contact-form">
                <input type="text" placeholder="Name" required>
                <input type="email" placeholder="Email" required>
                <textarea placeholder="Your Message" rows="5" required></textarea>
                <button type="submit" class="btn primary">Send Message</button>
            </form>
        </div>
    </section>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox">
        <span class="close-lightbox">&times;</span>
        <img class="lightbox-content" id="lightbox-img">
    </div>

    <footer class="footer">
        <p>&copy; 2026 Ritesh Bavi. Designed for Business Excellence.</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
